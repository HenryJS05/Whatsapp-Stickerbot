# Grupos de WhatsApp autorizados separados por coma.
# Si lo dejas vacío o "*", procesará en todos los grupos donde esté añadido.
# Puedes ver el ID del grupo en la consola cuando llegue un mensaje o enviando ".id" al grupo.
ALLOWED_GROUPS=

# Metadatos del sticker (visibles al ver la información del sticker en WhatsApp)
STICKER_PACK_NAME="dcss-stickers"
STICKER_AUTHOR="DCSS Bot"

# Duración máxima para videos o GIFs en segundos (WhatsApp recomienda <= 8s)
MAX_VIDEO_DURATION_SECONDS=8
